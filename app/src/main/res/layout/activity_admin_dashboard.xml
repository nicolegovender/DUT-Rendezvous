<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 1. TOP HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#3F2B7B"
        android:padding="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#FFFFFF"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <!-- 2. WELCOME TEXT -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome, Staff!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#000000"/>

    <!-- 3. GRID OF ICONS -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:padding="16dp">

        <!-- Item 1: Today's Orders (ID added) -->
        <LinearLayout
            android:id="@+id/cardTodaysOrders"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="#FFFFFF">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_agenda"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Orders"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Item 2: Today's Reservations (ID added) -->
        <LinearLayout
            android:id="@+id/cardTodaysReservations"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="#FFFFFF">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_my_calendar"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Reservations"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Item 3: Menu Items (ID added) -->
        <LinearLayout
            android:id="@+id/cardMenuItems"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="#FFFFFF">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_edit"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu Items"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Item 4: Low Stock Items (ID added) -->
        <LinearLayout
            android:id="@+id/cardLowStock"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="#FFFFFF">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_gallery"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Low Stock Items"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </GridLayout>

    <!-- 4. BOTTOM LIST (Orders, Reservations, Logout) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ID added -->
        <TextView
            android:id="@+id/tvMenuOrders"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Orders  >"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <!-- ID added -->
        <TextView
            android:id="@+id/tvMenuReservations"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Reservations  >"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <!-- ID added -->
        <TextView
            android:id="@+id/tvMenuLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Logout  >"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>