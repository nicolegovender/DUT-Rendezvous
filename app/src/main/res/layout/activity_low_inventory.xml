<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low Inventory Items"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#4B2E83" />

        <EditText
            android:id="@+id/etItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Menu Item Name"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity Remaining"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnAddItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Item"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4B2E83" />

        <TextView
            android:id="@+id/tvInventoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Items will appear here"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>